# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/xiexiaoshuopro

# Redis (for BullMQ queues)
REDIS_URL=redis://localhost:6379

# Application
APP_SECRET=change-me-in-production-please-use-a-long-random-string

# Encryption key for API key storage (>= 16 chars)
ENCRYPTION_KEY=change-me-please-use-a-long-random-string-32-chars

# Defaults
DEFAULT_LLM_TIMEOUT_SECONDS=60
MAX_PARALLEL_CHARACTER_CALLS=5
MAX_CONTEXT_TOKENS=12000
TRACE_RETENTION_DAYS=30
SNAPSHOT_MAX_MB=50
PROVIDER_DEFAULT_RATE_LIMIT_PER_MIN=60
WEBSOCKET_HEARTBEAT_SECONDS=30
